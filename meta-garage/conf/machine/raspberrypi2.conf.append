# Enable I2C and add config.txt entry
ENABLE_I2C = "1"
RPI_EXTRA_CONFIG += "dtparam=i2c_arm=on"

ENABLE_SPI = "1"
RPI_EXTRA_CONFIG += "dtparam=spi=on"
#RPI_EXTRA_CONFIG += "dtoverlay=spi1-2cs"

# Optional: autoload the kernel modules
KERNEL_MODULE_AUTOLOAD_rpi += " i2c-dev i2c-bcm2708"
KERNEL_MODULE_AUTOLOAD_rpi += " spidev spi_bcm2835 spi_bcm2835aux"
