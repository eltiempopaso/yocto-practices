From 4bfbb3fb566eda88f77c04e52fab9f75544b5e6e Mon Sep 17 00:00:00 2001
From: Oriol Parera <oriol.parera.kernel@gmail.com>
Date: Wed, 5 Aug 2026 15:59:27 +0200
Subject: [PATCH] nunchuk and push butoon overlay

---
 arch/arm/boot/dts/overlays/Makefile           |  1 +
 .../arm/boot/dts/overlays/nunchuk-overlay.dts | 52 +++++++++++++++++++
 2 files changed, 53 insertions(+)
 create mode 100644 arch/arm/boot/dts/overlays/nunchuk-overlay.dts

diff --git a/arch/arm/boot/dts/overlays/Makefile b/arch/arm/boot/dts/overlays/Makefile
index 367cbf437e1b..815e47e1cf4e 100644
--- a/arch/arm/boot/dts/overlays/Makefile
+++ b/arch/arm/boot/dts/overlays/Makefile
@@ -185,6 +185,7 @@ dtbo-$(CONFIG_ARCH_BCM2835) += \
 	mlx90640.dtbo \
 	mmc.dtbo \
 	mz61581.dtbo \
+	nunchuk.dtbo \
 	ov2311.dtbo \
 	ov5647.dtbo \
 	ov64a40.dtbo \
diff --git a/arch/arm/boot/dts/overlays/nunchuk-overlay.dts b/arch/arm/boot/dts/overlays/nunchuk-overlay.dts
new file mode 100644
index 000000000000..1623172b4a1b
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/nunchuk-overlay.dts
@@ -0,0 +1,52 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+
+
+fragment@0 {
+    target = <&i2c1>;
+
+    __overlay__ {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        nunchuk: nunchuk@52 {
+            compatible = "nintendo,nunchuk";
+            reg = <0x52>;
+            variant = "white";
+        };
+    };
+};
+
+
+
+    fragment@1 {
+        target = <&gpio>;
+
+        __overlay__ {
+            button_pins: button_pins {
+                brcm,pins = <27>;
+                brcm,function = <0>;
+                brcm,pull = <2>;
+            };
+        };
+    };
+
+    fragment@2 {
+        target-path = "/";
+
+        __overlay__ {
+            push_button {
+                compatible = "garage,my-push-button";
+
+                pinctrl-names = "default";
+                pinctrl-0 = <&button_pins>;
+
+                button-gpios = <&gpio 27 0>;
+
+                status = "okay";
+            };
+        };
+    };
+};
-- 
2.39.5

