#!/bin/sh
### BEGIN INIT INFO
# Provides:          chess-station-app-init
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start chess-station at boot time
# Description:       Enable service provided by chess-station-app
### END INIT INFO

APPDIR="/opt/chess-station"
PIDFILE="/run/chess-station-app.pid"
PATH="/sbin:/bin:/usr/sbin:/usr/bin"

case "$1" in
    start)
        echo "Starting chess-station..."
        cd "$APPDIR" || exit 1
        if [ -f lichess.token ]; then
            export CHESSTATION_LICHESS_TOKEN="$(cat lichess.token)"
        fi
        export QT_QPA_PLATFORM=eglfs
        start-stop-daemon \
            --start \
            --background \
            --make-pidfile \
            --pidfile "$PIDFILE" \
            --exec /usr/bin/python3 \
            -- main.py || exit $?
        ;;
    stop)
        echo "Stopping chess-station..."
        if [ -f "$PIDFILE" ]; then
            start-stop-daemon --stop --pidfile "$PIDFILE" || exit $?
        else
            echo "chess-station is not running."
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac

exit 0
